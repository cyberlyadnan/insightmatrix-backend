# =============================================================================
# Copy to `.env.production` on the production server (do NOT commit .env.production)
# Loaded when NODE_ENV=production (see src/config/env.ts)
# Fill REPLACE_* values from your live secrets.
# =============================================================================

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

CLIENT_URL=https://insightmatrix.online
API_PUBLIC_URL=https://insightmatrix.online

MONGO_URI=REPLACE_WITH_PRODUCTION_MONGO_URI
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_PRODUCTION_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_PRODUCTION_SECRET

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_MIN=30

COOKIE_DOMAIN=.insightmatrix.online
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

SKIP_EMAIL_VERIFICATION=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM=InsightMatrix <noreply@insightmatrix.online>
SMTP_REPLY_TO=REPLACE_WITH_REPLY_TO_EMAIL

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

SECURITY_GATEWAY_ENABLED=false
SECURITY_CAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET
RECAPTCHA_VERSION=v3
RECAPTCHA_MIN_SCORE=0.5

SECURITY_UNIQUE_IP_ENABLED=false
SECURITY_GEO_ENABLED=false
SECURITY_BOT_ENABLED=false
SECURITY_BOT_BLOCK=false
