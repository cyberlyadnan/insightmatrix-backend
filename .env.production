# =============================================================================
# InsightMatrix backend — PRODUCTION
# Loaded when NODE_ENV=production (overrides .env on the server).
# Copy to your VPS and fill REPLACE_* values from your live secrets.
# =============================================================================

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Must match frontend NEXT_PUBLIC_APP_URL exactly
CLIENT_URL=https://insightmatrix.online
# Email verification links — same host when API is proxied through Next (/api/v1)
API_PUBLIC_URL=https://insightmatrix.online

# --- Required secrets (replace before deploy) ---
MONGO_URI=REPLACE_WITH_PRODUCTION_MONGO_URI
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_PRODUCTION_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_PRODUCTION_SECRET

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_MIN=30

# HTTPS cookies — same parent domain as the public site
COOKIE_DOMAIN=.insightmatrix.online
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

SKIP_EMAIL_VERIFICATION=false

# SMTP (production mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM=InsightMatrix <noreply@insightmatrix.online>
SMTP_REPLY_TO=REPLACE_WITH_REPLY_TO_EMAIL

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=REPLACE_OR_LEAVE_EMPTY
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=insightmatrix

# =============================================================================
# Gateway security — stabilization defaults (advanced checks log-only in code)
# =============================================================================
SECURITY_GATEWAY_ENABLED=false
SECURITY_CAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=6LdRbf0sAAAAANhwNdOBewg3O1APDu1iYAhT_-Ib
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET
RECAPTCHA_VERSION=v3
RECAPTCHA_MIN_SCORE=0.5

SECURITY_UNIQUE_IP_ENABLED=false
SECURITY_UNIQUE_IP_WINDOW_MINUTES=60
SECURITY_UNIQUE_IP_MAX_PER_SURVEY=3
SECURITY_UNIQUE_IP_MAX_PER_ALLOCATION=5
SECURITY_UNIQUE_IP_BLOCK=false

SECURITY_GEO_ENABLED=false
GEOIP_API_URL=http://ip-api.com/json

SECURITY_BOT_ENABLED=false
SECURITY_BOT_BLOCK=false
