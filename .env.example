NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGO_URI=mongodb://127.0.0.1:27017/insightmatrix
# Public Next.js site — must match NEXT_PUBLIC_APP_URL on the frontend (no trailing slash).
CLIENT_URL=http://localhost:3000

# Public URL of this API (email verification links hit the API). No trailing slash.
API_PUBLIC_URL=http://localhost:5000

# Production example:
# CLIENT_URL=https://your-domain.com
# API_PUBLIC_URL=https://api.your-domain.com
# COOKIE_DOMAIN=your-domain.com
# COOKIE_SECURE=true

# Auto-verify new registrations (skips email + issues cookies immediately when testing locally).
SKIP_EMAIL_VERIFICATION=false

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_MIN=30

# Optional: isolate B2B vendor JWT signing (recommended in production)
VENDOR_JWT_ACCESS_SECRET=
VENDOR_JWT_REFRESH_SECRET=

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=insightmatrix

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=InsightMatrix <no-reply@insightmatrix.com>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Optional overrides for `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@insightmatrix.local
SEED_ADMIN_PASSWORD=Admin123!

# =============================================================================
# Gateway security & traffic validation (vendor + panel routing)
# https://www.google.com/recaptcha/admin — create v3 keys for production
# =============================================================================

# Master switch — set false to bypass the entire security pipeline (local debugging only)
SECURITY_GATEWAY_ENABLED=false

# --- Google reCAPTCHA (free) — site key is also exposed to the frontend via NEXT_PUBLIC_RECAPTCHA_SITE_KEY ---
SECURITY_CAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v2 | v3 (v3 recommended; frontend GatewayCaptcha uses v3 script)
RECAPTCHA_VERSION=v3
# v3 only: minimum score 0.0–1.0 (default 0.5)
RECAPTCHA_MIN_SCORE=0.5

# --- Unique IP / duplicate session filtering (analytics only — does not block traffic) ---
SECURITY_UNIQUE_IP_ENABLED=false
# Rolling window for duplicate-IP counts (minutes)
SECURITY_UNIQUE_IP_WINDOW_MINUTES=60
# Max gateway starts from same IP per survey in the window
SECURITY_UNIQUE_IP_MAX_PER_SURVEY=3
# Max gateway starts from same IP per vendor allocation in the window
SECURITY_UNIQUE_IP_MAX_PER_ALLOCATION=2
# Legacy flag — pipeline stabilization ignores hard blocks for non-captcha rules
SECURITY_UNIQUE_IP_BLOCK=false

# --- Geo-location filtering (analytics only — does not block traffic) ---
SECURITY_GEO_ENABLED=false
# Free tier: http://ip-api.com/json/{ip}?fields=status,country,countryCode,regionName,city
# Production: MaxMind, IPinfo, ipdata.co, etc. (must return JSON with countryCode)
GEOIP_API_URL=http://ip-api.com/json

# --- Bot detection (analytics only — does not block traffic) ---
SECURITY_BOT_ENABLED=false
SECURITY_BOT_BLOCK=false

# VPN/proxy detection is not wired to env yet (stub disabled in code). Add provider keys when implemented.

# =============================================================================
# Production: copy `.env.production` to the server, fill REPLACE_* values, and set
# NODE_ENV=production (env.ts loads .env.production automatically in production).
# CLIENT_URL must match frontend NEXT_PUBLIC_APP_URL exactly.
# =============================================================================
# Stabilization note: only CAPTCHA may hard-block when SECURITY_GATEWAY_ENABLED=true.
